<Window x:Class="TestNovellRev2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestNovellRev2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" x:Name="GameWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="0.05*"/>
        </Grid.RowDefinitions>
        <Canvas Panel.ZIndex="1"  x:Name="Background" Grid.RowSpan="3"/>
        <ScrollViewer Height="100" Width="200" Background="DodgerBlue" x:Name="ChoicesScroll" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalScrollBarVisibility="Hidden">
            <StackPanel Panel.ZIndex="2"  x:Name="ChoicesBox">
            </StackPanel>
        </ScrollViewer>
        <StackPanel Panel.ZIndex="2" x:Name="Dialogs" Grid.Row="1">
            <GroupBox BorderThickness="0" Width="{Binding ElementName=Dialogs, Path=ActualWidth, UpdateSourceTrigger=PropertyChanged}" Height="{Binding ElementName=Dialogs, Path=ActualHeight, UpdateSourceTrigger=PropertyChanged}">
                <GroupBox.Header>
                    <TextBlock x:Name="DialogHeader" FontSize="16" FontFamily="Impact"/>
                </GroupBox.Header>
                <TextBlock x:Name="DataDialog" FontSize="14" Margin="20,10,0,0" FontFamily="Times New Roman"/>
            </GroupBox>
        </StackPanel>
        <StackPanel Panel.ZIndex="2" x:Name="Menu" Grid.Row="2"/>
    </Grid>
</Window>
