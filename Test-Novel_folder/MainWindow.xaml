<Window x:Class="TestNovell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestNovell"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="0.05*"/>
        </Grid.RowDefinitions>
        <Canvas Panel.ZIndex="0" x:Name="Background" Grid.RowSpan="3"/>
        <StackPanel Panel.ZIndex="1"  Width="100" Height="300" x:Name="Choice" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Panel.ZIndex="1" x:Name="Dialogs" Grid.Row="1"/>
        <StackPanel Panel.ZIndex="1" x:Name="Menu" Grid.Row="2"/>
    </Grid>
</Window>
